<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <origin xyz="0.075 0 0.06" rpy="0 0.3 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.02 0.04 0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
    </link>

    <!-- New Gazebo (gz sim) camera: needs the Sensors system in the world.
         Gz topic is camera_sensor/image_raw, bridged to ROS in gazebo_launch.py -->
    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <topic>camera_sensor/image_raw</topic>
            <camera>
                <horizontal_fov>2.047</horizontal_fov>
                <image>
                    <width>800</width>
                    <height>600</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>20</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>
