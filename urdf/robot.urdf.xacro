<?xml version="1.0"?>

<robot name="line_maze_solver" xmlns:xacro="http://www.ros.org/wiki/xacro">


    <xacro:include filename="camera.xacro"/>
    


    <link name="chassis">
        <visual>
            <origin xyz="0.0 0.0 0.0"/>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
            <geometry>
                <box size="0.15 0.15 0.05"/> 
            </geometry>
        </visual>
        <inertial>
            <mass value="3.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <box size="0.15 0.15 0.05"/>
            </geometry>
        </collision>
        
    </link>


    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.02"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0.0 0.0" />
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.02"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>

    </link>


    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy=" 1.57 0.0 0.0" />
            <geometry>
                <cylinder radius="0.03" length="0.02"/>
            </geometry>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                    
                </material>
        </visual>
               <collision>
            <geometry>
                <cylinder radius="0.03" length="0.02"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>

    </link>

    <link name="castor_wheel">
        <visual>
            <origin xyz="0 0 0" />
                <geometry>
                    <sphere radius="0.01"/>
                </geometry>
                <material name="red">
                    <color rgba="1 0 0 1"/> 
                </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>

        


    </link>

    <link name="castor_wheel_lateral">
        <visual>
            <origin xyz="0 0 0" />
                <geometry>
                    <sphere radius="0.01"/>
                </geometry>
                <material name="red">
                    <color rgba="1 0 0 1"/> 
                </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>

        


    </link>

    <!-- joint ahead -->

    <joint name="left_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="left_wheel"/>
        <origin xyz="-0.055 0.085 -0.005" />
        <axis xyz="0 1 0"/> 
    </joint>

     <joint name="right_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="right_wheel"/>
        <origin xyz="-0.055 -0.085 -0.005" />
        <axis xyz="0 1 0"/> 
    </joint>

    <joint name="castor_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="castor_wheel_lateral"/>
        <origin xyz="0.050 0 -0.025" />
        <axis xyz="0 1 0"/> 
    </joint>
    <joint name="castor_wheel_joint_lateral" type="continuous">
        <parent link="chassis"/>
        <child link="castor_wheel"/>
        <origin xyz="0.050 0 -0.025" />
        <axis xyz="1 0 0"/> 
    </joint>




    <!-- ===== Friction (converted to SDF surface friction by sdformat) ===== -->
    <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
    <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
    <!-- castor balls should slide, not grip -->
    <gazebo reference="castor_wheel"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
    <gazebo reference="castor_wheel_lateral"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

    <!-- ===== gz sim systems (replace libgazebo_ros_diff_drive.so) ===== -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.17</wheel_separation>
            <wheel_radius>0.03</wheel_radius>
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>chassis</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>
        </plugin>

        <!-- publishes wheel angles so RViz shows the wheels turning -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
    </gazebo>

</robot>