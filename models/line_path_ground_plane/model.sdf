<?xml version="1.0"?>
<sdf version="1.9">
  <model name="line_path_ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>40 40</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>40 40</size>
          </plane>
        </geometry>
        <!-- Classic .material scripts are not supported by gz sim: use a PBR texture.
             The emissive map makes the white line render fully white regardless of the sun,
             while the black floor stays black. -->
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://line_path_ground_plane/materials/textures/path_2_4096.png</albedo_map>
              <emissive_map>model://line_path_ground_plane/materials/textures/path_2_4096.png</emissive_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
