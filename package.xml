<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>line_maze_solver</name>
  <version>0.1.0</version>
  <description>Vision-based line-following robot in Gazebo (gz sim) and ROS 2, with a PID controller and a pretrained CNN controller</description>
  <maintainer email="rohitjangra7370@gmail.com">Rohit_Jangra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- not a rosdep key: pip install --user --break-system-packages onnxruntime -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
